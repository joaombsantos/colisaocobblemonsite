generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums

enum ServerType {
  KANTO
  KANTO_PLUS
  SURVIVAL
}

enum ProductCategory {
  VIPS
  CAIXAS
  PASSES
}

// Models

model Product {
  id               String          @id @default(uuid())
  productName      String
  photoUrl         String
  price            Decimal
  server           ServerType
  category         ProductCategory
  description      String?
  descriptionImage String
  command          String?
  requireOnline    Boolean         @default(false)

  cartItems CartItem[]
}

model Cart {
  id   String @id @default(uuid())
  nick String @unique

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id       String @id @default(uuid())
  quantity Int    @default(1)

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model DeliveryQueue {
  id        String     @id @default(uuid())
  nick      String
  command   String
  server    ServerType
  createdAt DateTime   @default(now())
}
